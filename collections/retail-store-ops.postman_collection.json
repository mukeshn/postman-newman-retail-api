{
  "info": {
    "name": "Retail Store Ops API",
    "description": "Store finder, inventory and click & collect regression collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response time under 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Stores",
      "item": [
        {
          "name": "List stores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/stores"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('six stores with opening hours', () => {",
                  "  pm.expect(body.count).to.eql(6);",
                  "  body.stores.forEach(s => pm.expect(s.open).to.match(/^\\d{2}:\\d{2}$/));",
                  "});",
                  "pm.collectionVariables.set('storeId', body.stores[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Nearest stores from Augsburg",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/stores?lat={{augsburgLat}}&lng={{augsburgLng}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { stores } = pm.response.json();",
                  "pm.test('sorted by distance', () => {",
                  "  const d = stores.map(s => s.distanceKm);",
                  "  pm.expect(d).to.eql([...d].sort((a, b) => a - b));",
                  "});",
                  "pm.test('Augsburg store is closest', () => pm.expect(stores[0].id).to.eql('AUG-01'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown store",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/stores/XXX-99"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error).to.eql('STORE_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Inventory for store",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/inventory?store={{storeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = { type: 'object', required: ['count', 'items'], properties: { items: { type: 'array', items: { type: 'object', required: ['storeId', 'sku', 'onHand', 'status'], properties: { status: { enum: ['OK', 'LOW', 'OUT_OF_STOCK'] }, onHand: { type: 'integer', minimum: 0 } } } } } };",
                  "pm.test('matches schema', () => pm.response.to.have.jsonSchema(schema));",
                  "const item = pm.response.json().items.find(i => i.onHand > 2);",
                  "pm.collectionVariables.set('sku', item.sku);",
                  "pm.collectionVariables.set('onHandBefore', item.onHand);"
                ]
              }
            }
          ]
        },
        {
          "name": "Receive stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/inventory/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"sku\": \"{{sku}}\",\n  \"delta\": 5,\n  \"reason\": \"RECEIPT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('onHand increased by 5', () => pm.expect(pm.response.json().onHand).to.eql(Number(pm.collectionVariables.get('onHandBefore')) + 5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject negative stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/inventory/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"sku\": \"{{sku}}\",\n  \"delta\": -100000,\n  \"reason\": \"SALE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 NEGATIVE_STOCK', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().error).to.eql('NEGATIVE_STOCK'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unknown reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/inventory/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"sku\": \"{{sku}}\",\n  \"delta\": 1,\n  \"reason\": \"GIFT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "CSV import with one bad line",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/inventory/import",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"csv\": \"storeId,sku,onHand\\nAUG-01,RT-100,15\\nAUG-01,RT-101,9\\nAUG-01,RT-999,1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('2 updated, 1 rejected', () => { pm.expect(r.updated).to.eql(2); pm.expect(r.rejected).to.have.length(1); pm.expect(r.rejected[0].line).to.eql(4); });"
                ]
              }
            }
          ]
        },
        {
          "name": "CSV export",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/inventory/export.csv?store=AUG-01"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('csv attachment', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('inventory-AUG-01.csv');",
                  "});",
                  "pm.test('imported value exported', () => pm.expect(pm.response.text()).to.include('AUG-01,RT-100,Everyday Sneaker White,15,10'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Click & Collect",
      "item": [
        {
          "name": "Reserve items",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/click-collect",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"AUG-01\",\n  \"customerName\": \"{{customerName}}\",\n  \"email\": \"{{customerEmail}}\",\n  \"lines\": [\n    {\n      \"sku\": \"RT-100\",\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('customerName', 'Newman ' + Date.now());",
                  "pm.collectionVariables.set('customerEmail', `newman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 RESERVED', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('RESERVED'); });",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set('orderId', o.id);",
                  "pm.collectionVariables.set('pickupCode', o.pickupCode);",
                  "pm.test('6-digit pickup code', () => pm.expect(o.pickupCode).to.match(/^\\d{6}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong pickup code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/click-collect/{{orderId}}/pickup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupCode\": \"000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hand over",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/click-collect/{{orderId}}/pickup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupCode\": \"{{pickupCode}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('COLLECTED', () => pm.expect(pm.response.json().status).to.eql('COLLECTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cannot hand over twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/click-collect/{{orderId}}/pickup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupCode\": \"{{pickupCode}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 INVALID_STATE', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Not available in store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/retail/click-collect",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"AUG-01\",\n  \"customerName\": \"X\",\n  \"email\": \"x@example.com\",\n  \"lines\": [\n    {\n      \"sku\": \"RT-100\",\n      \"quantity\": 9999\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "storeId",
      "value": ""
    },
    {
      "key": "sku",
      "value": ""
    },
    {
      "key": "onHandBefore",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "pickupCode",
      "value": ""
    },
    {
      "key": "customerName",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    }
  ]
}
